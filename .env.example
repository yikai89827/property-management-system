# 服务端口
PORT=3000
# SQLite 数据库文件路径
DATABASE_PATH=./data/pms.db
# 敏感字段加密密钥（32 字节 hex，AES-256-GCM）
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# 盲索引密钥（32 字节 hex，HMAC-SHA256）
BLIND_INDEX_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
# JWT 访问令牌密钥
JWT_ACCESS_SECRET=change-me-access-secret
# JWT 刷新令牌密钥
JWT_REFRESH_SECRET=change-me-refresh-secret
# 业主端短期令牌有效期（秒）
JWT_OWNER_TTL=7200
# 默认物业公司名称（种子初始化）
DEFAULT_COMPANY_NAME=株洲桌信物业管理有限责任公司
# 单据编号前缀
RECEIPT_NO_PREFIX=PM
# 服务监听地址（0.0.0.0 便于局域网访问）
HOST=0.0.0.0
# 业主端 H5 基础地址（二维码物料生成用；局域网请改为本机 IP，如 http://192.168.x.x:5171）
H5_BASE_URL=http://localhost:5171